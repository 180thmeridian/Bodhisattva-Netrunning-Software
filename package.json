{
  "name": "cp2020-netrun-terminal",
  "version": "1.6.6",
  "description": "CP2020 Netrun Terminal — offline Phaser helper",
  "main": "main.js",
  "author": "Netrun Terminal",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --x64",
    "dist:win:full": "electron-builder --win portable --win nsis --x64",
    "make-update": "node tools/make-update.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.6.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.netrun.terminal",
    "productName": "CP2020 Netrun Terminal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "data/**/*",
      "version.txt",
      "README.md"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data"
      }
    ],
    "publish": null,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "CP2020-Netrun-Terminal-${version}-portable.exe"
    },
    "forceCodeSigning": false,
    "asar": true
  }
}
